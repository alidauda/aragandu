# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/argandu_farm"
# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Public origin of the app
BETTER_AUTH_URL="http://localhost:3000"
# Optional — the buyer portal on its own address, e.g. "https://customer.argandufarms.com.ng".
# That address then serves only the portal ("/" is its home); buyer emails and Paystack use it.
# Leave empty to keep the portal at /portal on the address above.
PORTAL_URL=""
# Optional — outgoing email (invites, invoices, order and payment alerts). Leave the keys
# empty to keep email off; everything else works the same. Zoho is used when its key is set.
# Zoho CPaaS / ZeptoMail: the agent's API key from Agents → your agent → SMTP/API.
ZOHO_EMAIL_API_KEY=""
# Or Resend (https://resend.com):
RESEND_API_KEY=""
# A sender on the verified domain, e.g. "Argandu Farms <noreply@argandufarms.com.ng>"
EMAIL_FROM=""
# Optional — online payment in the buyer portal via https://paystack.com.
# Leave empty to hide "Pay now". Use sk_test_… while testing, sk_live_… to take real money.
PAYSTACK_SECRET_KEY=""
